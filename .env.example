# Copy to .env and fill in. Never commit .env.
PORT=3005

# The townsfolk's voices, tried in this order. Leave a key blank to skip that provider.
# With no keys at all, everyone falls back to their written lines.
AIAND_API_KEY=
AIAND_MODEL=google/gemma-4-31b-it
AIAND_REASONING_EFFORT=none
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Limits
AI_TIMEOUT_MS=8000
AIAND_RPM=60
GROQ_RPM=25
GEMINI_RPM=12
AI_PER_IP_PER_MINUTE=20
AI_DAILY_CAP_GLOBAL=5000
